# Report Fusion Hub - Environment Configuration
# Copy this file to .env and update the values for your setup

# =============================================================================
# SERVER
# =============================================================================
NODE_ENV=development
PORT=8945

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRY=12h

# =============================================================================
# DATABASE
# =============================================================================
# Local dev (direct connection):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/report_fusion_hub"

# Docker Compose overrides this automatically — no changes needed for Docker.

# =============================================================================
# FRONTEND (VITE — baked at build time)
# =============================================================================
# Backend URL the frontend calls (no trailing slash, no /api suffix)
VITE_API_URL=http://localhost:8945

# Vite dev server port
VITE_FRONTEND_PORT=6234

# =============================================================================
# CORS
# =============================================================================
# Frontend origin for CORS (must match where the browser loads the app)
FRONTEND_URL=http://localhost:6234

# =============================================================================
# SECURITY
# =============================================================================
# REQUIRED. AES-256-GCM key for file encryption. Generate with: openssl rand -base64 32
FILE_ENCRYPTION_KEY=your-base64-encoded-key-here

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# DOCKER COMPOSE (only used by docker-compose.yml)
# =============================================================================
# PostgreSQL credentials for the db service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=report_fusion_hub

# Host port mappings (change if defaults conflict)
# FRONTEND_PORT=6234
# DB_PORT=5432

# Backup retention in days
# BACKUP_RETENTION_DAYS=30

# =============================================================================
# DIFY AI CHATBOT (optional — feature disabled if absent)
# =============================================================================
# VITE_DIFY_TOKEN=your_dify_token_here
# VITE_DIFY_BASE_URL=https://your-dify-instance.com
