// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Models for Template Packs, which group multiple ReportTemplates
model TemplatePack {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  items       TemplatePackItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model TemplatePackItem {
  id           String         @id @default(cuid())
  packId       String
  pack         TemplatePack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  templateId   String
  template     ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade) // A pack item points to a ReportTemplate
  displayOrder Int

  @@unique([packId, templateId])
  @@unique([packId, displayOrder])
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

